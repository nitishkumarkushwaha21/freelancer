PORT=5000
# Local:
# MONGO_URI=mongodb://127.0.0.1:27017/builtbywho
# Atlas (include the database name; URL-encode special chars in the password):
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/builtbywho?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/builtbywho
CLIENT_URL=http://localhost:5173

# Auth (run npm run seed to create the default admin user)
JWT_SECRET=change-this-to-a-long-random-string
